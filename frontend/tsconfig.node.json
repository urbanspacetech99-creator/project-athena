{
  "compilerOptions": {
    "composite": true,
    // Type-check vite.config.ts without emitting vite.config.js beside it: Vite
    // resolves vite.config.js BEFORE vite.config.ts, so a stale emitted copy
    // silently shadows every edit to the source (dev proxy, port, plugins).
    "emitDeclarationOnly": true,
    "skipLibCheck": true,
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "types": ["node"]
  },
  "include": ["vite.config.ts"]
}

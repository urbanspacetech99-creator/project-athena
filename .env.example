# --- Core ---
# Postgres connection URL. Local default: postgresql+psycopg://athena:athena@localhost:5432/athena
# Remote example (URL-encode special chars in the password; add sslmode for managed PG):
#   postgresql+psycopg://USER:PASSWORD@HOST:5432/athena?sslmode=require
DATABASE_URL=
# Test-suite database (optional). When set, pytest uses it instead of spinning up a
# throwaway Docker Postgres (testcontainers). MUST be a dedicated empty database —
# the test fixtures create and drop every table per test.
TEST_DATABASE_URL=
# Fixture-data database. Served for every source when SOURCE_MODE=fixture, and for
# fixture-pinned sources in live mode (per-source routing); keeps fixture rows
# physically separate from live DATABASE_URL. MUST differ from TEST_DATABASE_URL (the
# test suite drops its tables). Empty -> single-DB fallback into DATABASE_URL, and
# fixture-pinned sources are skipped in live mode.
FIXTURE_DATABASE_URL=
# Global source mode: fixture | live (default: fixture)
SOURCE_MODE=
# Log level (default: INFO)
LOG_LEVEL=
# On startup: auto-create DB if missing, migrate schema to head, seed UrbanSpace
# defaults into empty config tables. true | false (default: true)
DB_AUTO_CREATE=
# Built dashboard directory, mounted at "/" when it exists (default: frontend/dist)
FRONTEND_DIST=
# Serve the dashboard at "/" when the dist exists. true | false (default: true)
SERVE_FRONTEND=

# --- Per-source overrides (empty means: use SOURCE_MODE) ---
META_SOURCE_MODE=
GOOGLE_REVIEWS_SOURCE_MODE=
GOOGLE_ADS_SOURCE_MODE=
ZOHO_SOURCE_MODE=
GOOGLE_PLACES_SOURCE_MODE=

# --- Feature flags ---
# FB competitor live fetch needs Meta PPCA approval. true | false (default: false)
COMPETITOR_LIVE_ACCESS_ENABLED=

# --- AI: text (Anthropic Claude) ---
CLAUDE_API_KEY=
# Text model id (default: claude-sonnet-5)
CLAUDE_MODEL=
# fake | live (default: fake)
LLM_MODE=

# --- AI: images (Google Gemini) ---
GEMINI_API_KEY=
# Image model id (default: gemini-2.5-flash-image)
GEMINI_IMAGE_MODEL=
# fake | live (default: fake)
IMAGE_MODE=

# --- Canva Connect ---
# fake | live (default: fake)
CANVA_MODE=
# Client id/secret are required by the token auto-refresh flow.
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
# Initial token; thereafter the DB-persisted rotating token is used.
CANVA_ACCESS_TOKEN=
CANVA_REFRESH_TOKEN=

# --- Meta Graph ---
META_PAGE_ID=
META_PAGE_TOKEN=
META_IG_USER_ID=

# --- Google (OAuth shared by reviews + ads) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GBP_ACCOUNT_ID=
GBP_LOCATION_ID=
GADS_DEVELOPER_TOKEN=
GADS_LOGIN_CUSTOMER_ID=
GADS_CUSTOMER_ID=
GOOGLE_PLACES_API_KEY=

# --- Zoho CRM ---
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# Zoho data centre (default: com)
ZOHO_DC=
# Custom module holding transcripts (default: Call_Logs; confirmed live 2026-07-10)
ZOHO_MODULE=
# Transcript field name (default: Transcript_Text)
ZOHO_TRANSCRIPT_FIELD=

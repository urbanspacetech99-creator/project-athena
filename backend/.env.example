# --- Core ---
# Postgres connection URL. Local default: postgresql+psycopg://athena:athena@localhost:5432/athena
DATABASE_URL=
# Dedicated DB for the test suite (conftest pg_url); tables are dropped per test.
TEST_DATABASE_URL=
# Fixture-mode data lives here, physically separate from the live DATABASE_URL
FIXTURE_DATABASE_URL=
# Global source mode: fixture | live (default: fixture)
SOURCE_MODE=
# Log level (default: INFO)
LOG_LEVEL=
# On startup: auto-create DB if missing, migrate schema to head, seed UrbanSpace
DB_AUTO_CREATE=
# Built dashboard directory, mounted at "/" when it exists. Use ../frontend/dist for local testing (default: frontend/dist)
FRONTEND_DIST=

# --- Per-source overrides (empty means: use SOURCE_MODE) ---
META_SOURCE_MODE=
GOOGLE_REVIEWS_SOURCE_MODE=
GOOGLE_ADS_SOURCE_MODE=
GOOGLE_PLACES_SOURCE_MODE=
ZOHO_SOURCE_MODE=

# --- Feature flags ---
# FB competitor live fetch needs Meta PPCA approval. true | false (default: false)
COMPETITOR_LIVE_ACCESS_ENABLED=

# --- AI: text (Anthropic Claude) ---
CLAUDE_API_KEY=
# Text model id (default: claude-sonnet-5)
CLAUDE_MODEL=
# fake | live (default: fake)
LLM_MODE=

# --- AI: images (Google Gemini) ---
GEMINI_API_KEY=
# Image model id (default: gemini-2.5-flash-image)
GEMINI_IMAGE_MODEL=
# fake | live (default: fake)
IMAGE_MODE=

# --- Canva Connect ---
# fake | live (default: fake)
CANVA_MODE=
# Client id/secret are required by the token auto-refresh flow.
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
# Initial token; thereafter the DB-persisted rotating token is used.
CANVA_ACCESS_TOKEN=
CANVA_REFRESH_TOKEN=

# --- Meta Graph ---
META_PAGE_ID=
META_PAGE_TOKEN=
META_IG_USER_ID=

# --- Google (one OAuth client, one grant per source) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Business Profile grant (scope business.manage)
GOOGLE_REVIEWS_REFRESH_TOKEN=
# Google Ads grant (scope adwords)
GOOGLE_ADS_REFRESH_TOKEN=
# Numeric GBP account id, e.g. 123456789012345, NOT the OAuth client id
GBP_ACCOUNT_ID=
# locations/{id} of the UrbanSpace listing
GBP_LOCATION_ID=
GADS_DEVELOPER_TOKEN=
GADS_LOGIN_CUSTOMER_ID=
GADS_CUSTOMER_ID=
GOOGLE_PLACES_API_KEY=

# --- Zoho CRM ---
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# Zoho data centre (default: com)
ZOHO_DC=
# Custom module holding transcripts (default: Call_Logs; confirmed live 2026-07-10)
ZOHO_MODULE=
# Transcript field name (default: Transcript_Text)
ZOHO_TRANSCRIPT_FIELD=
